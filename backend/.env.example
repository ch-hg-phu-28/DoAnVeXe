# Sao chép thành file .env rồi sửa giá trị. KHÔNG commit file .env lên GitHub.

# PostgreSQL và Redis (khớp với docker-compose.yml ở thư mục gốc)
DATABASE_URL="postgresql://datve:datve@localhost:5432/datve?schema=public"
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
APP_URL="http://localhost:3000"
# Danh sách origin của frontend được gọi API, cách nhau bằng dấu phẩy
CORS_ORIGIN="http://localhost:5173"

# Đăng nhập (đổi thành chuỗi ngẫu nhiên dài)
JWT_SECRET="doi-thanh-chuoi-bi-mat"
JWT_EXPIRES_IN="1d"

# Giữ ghế: thời gian giữ khi khách vừa chọn ghế, và thời hạn thanh toán sau khi tạo đơn (giây)
HOLD_TTL_SECONDS=600
PAYMENT_TTL_SECONDS=480

# Thanh toán: "mock" = giả lập để phát triển. Cổng thật (VNPay/MoMo sandbox) viết thêm provider.
PAYMENT_PROVIDER="mock"
PAYMENT_SECRET="doi-thanh-chuoi-bi-mat"

# Khóa để dịch vụ chatbot gọi các API /api/tools (gửi trong header x-tool-key)
CHATBOT_TOOL_KEY="doi-thanh-chuoi-bi-mat"

# Tắt giới hạn tần suất – CHỈ khi chạy kiểm thử đồng thời trên máy dev
DISABLE_THROTTLE=false

# Mật khẩu tài khoản mẫu khi chạy seed (chỉ dùng cho máy dev)
SEED_PASSWORD="Matkhau@123"

# Máy chủ gửi email (SMTP). Để trống SMTP_HOST thì email chỉ in ra log server, không gửi thật.
# Ví dụ Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USER là địa chỉ Gmail, SMTP_PASS là "mật khẩu ứng dụng".
# Địa chỉ trang web, dùng để tạo đường dẫn đặt lại mật khẩu trong email (F02)
FRONTEND_URL="http://localhost:5173"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Đặt vé xe <no-reply@example.com>"
